<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: lets adb run the update check now instead of waiting up to 12 hours.
             Guarded by DUMP, which adb's shell holds and normal apps cannot get. -->
        <receiver
            android:name=".work.DebugCheckReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
